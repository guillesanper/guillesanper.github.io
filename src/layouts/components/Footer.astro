---
import { getLangFromUrl, useTranslations } from '@src/i18n/utils';
import { CONTACT_EMAIL } from '@src/consts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class='container mt-8'>
  <div class="justify-center flex gap-4 py-8 prose dark:prose-invert text-sm">
    <a href={`mailto:${CONTACT_EMAIL}`}>{t('footer.contact')}</a>
    <a href="/rss.xml">{t('footer.rss')}</a>
  </div>
</footer>

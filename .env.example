# The public origin is NOT set here: it lives in `SITE_URL` in astro.config.mjs,
# which is its single source of truth.
#
# Every key below is optional. The site builds and works with all of them empty,
# which is the current state. They are read at build time with vite's `loadEnv`,
# so the names must match the code exactly (no PUBLIC_ prefix).

# GoatCounter site code: the part before .goatcounter.com, e.g. 'guillesanper'
GOATCOUNTER_CODE=''

# Google Search Console HTML-tag verification: only the `content` value
GOOGLE_SITE_VERIFICATION=''

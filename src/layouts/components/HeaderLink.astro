---
import type { HTMLAttributes } from 'astro/types';
import { stripLang } from '@src/i18n/utils';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

// Compare without the language prefix, so /es/about/ matches the About link the
// same way /about/ does.
const pathname = stripLang(Astro.url.pathname);
const target = stripLang(String(href ?? ''));
const subpath = pathname.match(/[^\/]+/g);
const isActive = target === pathname || target === '/' + subpath?.[0];
---

<a
	href={href}
	class:list={[className, { 'border-b border-zinc-500 dark:border-zinc-300': isActive }, { 'text-zinc-600 dark:text-zinc-200 hover:text-zinc-900 dark:hover:text-zinc-50': !isActive }, { 'text-zinc-950 dark:text-zinc-50': isActive }]}
	{...props}
>
	<slot />
</a>

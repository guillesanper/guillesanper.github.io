---
import { getLangFromUrl, useTranslations } from '@src/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Both lines are rebuilt client-side, so the script needs the templates rather
// than finished strings. Passing them through `t` keeps the language fallback.
const countTemplate = t('posts.showingCount', { count: '{count}', total: '{total}' });
const noResultsTemplate = t('posts.noResults', { query: '{query}' });
---

<div class='mb-8' role='search'>
	<label for='post-search' class='sr-only'>{t('posts.searchLabel')}</label>
	<div class='relative'>
		<svg
			class='pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-zinc-500 dark:text-zinc-400'
			xmlns='http://www.w3.org/2000/svg'
			width='18'
			height='18'
			viewBox='0 0 24 24'
			fill='none'
			stroke='currentColor'
			stroke-width='2'
			stroke-linecap='round'
			stroke-linejoin='round'
			aria-hidden='true'
			><circle cx='11' cy='11' r='8'></circle><path d='m21 21-4.3-4.3'></path></svg
		>
		<input
			id='post-search'
			type='search'
			autocomplete='off'
			data-search-input
			placeholder={t('posts.searchPlaceholder')}
			class='w-full rounded-xl border border-zinc-300 bg-transparent py-2.5 pl-10 pr-10 text-base
				placeholder:text-zinc-500 dark:border-zinc-700 dark:placeholder:text-zinc-400
				transition-colors duration-200
				hover:border-zinc-400 dark:hover:border-zinc-500
				focus:outline-none focus-visible:border-zinc-500 focus-visible:ring-2 focus-visible:ring-zinc-400'
		/>
		<button
			type='button'
			data-search-clear
			aria-label={t('posts.searchClear')}
			class='absolute right-2 top-1/2 hidden -translate-y-1/2 rounded-full p-1.5 text-zinc-500
				transition-colors duration-200 dark:text-zinc-400
				hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-zinc-100
				focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400'
		>
			<svg
				xmlns='http://www.w3.org/2000/svg'
				width='16'
				height='16'
				viewBox='0 0 24 24'
				fill='none'
				stroke='currentColor'
				stroke-width='2'
				stroke-linecap='round'
				stroke-linejoin='round'
				aria-hidden='true'><path d='M18 6 6 18'></path><path d='m6 6 12 12'></path></svg
			>
		</button>
	</div>

	{/* Both are filled in by the script: with no query there is nothing to report,
	    and without JS nothing is ever filtered. */}
	<p class='mt-3 text-sm text-zinc-600 dark:text-zinc-400' aria-live='polite' data-search-status></p>
	<p class='mt-6 hidden text-zinc-600 dark:text-zinc-300' data-search-empty></p>
</div>

<style>
	/* WebKit adds its own clear affordance to type=search; ours is styled to
	   match the site and sits in the same corner. */
	input[type='search']::-webkit-search-cancel-button,
	input[type='search']::-webkit-search-decoration {
		-webkit-appearance: none;
		appearance: none;
	}
</style>

<script is:inline define:vars={{ countTemplate, noResultsTemplate }}>
	(() => {
		const input = document.querySelector('[data-search-input]');
		if (!input) return;

		const cards = [...document.querySelectorAll('[data-post]')];
		const yearGroups = [...document.querySelectorAll('[data-year-group]')];
		const status = document.querySelector('[data-search-status]');
		const empty = document.querySelector('[data-search-empty]');
		const clear = document.querySelector('[data-search-clear]');
		const total = cards.length;

		// Same folding the cards were built with, so "criptografia" finds
		// "Criptografía" and case never matters.
		const normalize = (value) =>
			value
				.toLowerCase()
				.normalize('NFD')
				.replace(/[̀-ͯ]/g, '');

		function apply() {
			const raw = input.value.trim();
			const query = normalize(raw);
			let visible = 0;

			for (const card of cards) {
				const matches = !query || (card.dataset.search || '').includes(query);
				card.classList.toggle('hidden', !matches);
				if (matches) visible++;
			}

			// A year heading with nothing under it reads as a broken section.
			for (const section of yearGroups) {
				section.classList.toggle('hidden', !section.querySelector('[data-post]:not(.hidden)'));
			}

			clear.classList.toggle('hidden', !raw);
			status.textContent = query
				? countTemplate.replaceAll('{count}', String(visible)).replaceAll('{total}', String(total))
				: '';
			empty.textContent = noResultsTemplate.replaceAll('{query}', raw);
			empty.classList.toggle('hidden', !(query && visible === 0));
		}

		input.addEventListener('input', apply);
		input.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') {
				input.value = '';
				apply();
			}
		});
		clear.addEventListener('click', () => {
			input.value = '';
			input.focus();
			apply();
		});

		// Browsers restore the field on back-navigation, so the list has to be
		// brought back in sync with whatever is already in it.
		apply();
	})();
</script>

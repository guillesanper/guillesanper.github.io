---
import BaseLayout from '@src/layouts/BaseLayout.astro';
import PostGallery from '@src/components/PostGallery.astro';
import PostSearch from '@src/components/PostSearch.astro';
import { getLangFromUrl, useTranslations } from '@src/i18n/utils';
import { getPostsFor, entriesOf } from '@src/i18n/posts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const title = t('posts.title');
const description = t('posts.description');
const posts = entriesOf(await getPostsFor(lang));
---

<BaseLayout title={title} description={description}>
  <div class='container'>
    <div class="mb-8">
      <h1 class="text-3xl font-bold mb-2">{title}</h1>
      <p class="text-zinc-700 dark:text-zinc-300 text-lg">{description}</p>
    </div>
    <PostSearch />
    <PostGallery posts={posts}/>
  </div>
</BaseLayout>

---
import { getLangFromUrl, useTranslations } from '@src/i18n/utils';
import { AUTHOR_NAME, CONTACT_EMAIL, GITHUB_URL } from '@src/consts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();

const link = 'text-zinc-600 no-underline transition-colors hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-zinc-50';
---

<footer class='container mt-16'>
  <div class="flex flex-col-reverse gap-4 border-t border-zinc-200 py-8 text-sm sm:flex-row sm:items-center sm:justify-between dark:border-zinc-800">
    <p class="text-zinc-500 dark:text-zinc-400">© {year} {AUTHOR_NAME}</p>
    <nav class="flex gap-6">
      <a class={link} href={`mailto:${CONTACT_EMAIL}`}>{t('footer.contact')}</a>
      <a class={link} href={GITHUB_URL} target="_blank" rel="noopener noreferrer">{t('footer.github')}</a>
    </nav>
  </div>
</footer>

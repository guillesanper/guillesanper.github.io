---
import { existsSync } from 'node:fs';
import { SITE_TITLE, AUTHOR_NAME, AUTHOR_ROLE, GITHUB_URL, CV_PATH } from '@src/consts';
import BaseLayout from '@src/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import Ava from '@src/assets/img/ava.jpg';
import Prose from '@src/components/Prose.astro';
import { projects, localizeProjects } from '@src/pages/projects/projects';
import ProjectList from '@src/components/ProjectList.astro';
import ContactMenu from '@src/components/ContactMenu.astro';
import PostItem from '@src/components/PostItem.astro';
import { getLangFromUrl, useTranslations, localizePath } from '@src/i18n/utils';
import { getPostsFor, entriesOf, type BlogPost } from '@src/i18n/posts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const top6Projects = localizeProjects(projects.slice(0, 6), lang);
const posts = entriesOf(await getPostsFor(lang)).slice(0, 5);

// The CV link only renders once the PDF is actually in public/, so the button
// never leads to a 404.
const hasCv = existsSync(new URL(`../../../public${CV_PATH}`, import.meta.url));

const secondaryButton = `inline-flex items-center gap-2 rounded-full border border-zinc-300 px-4 py-2
	text-sm font-medium text-zinc-800 no-underline transition-colors duration-200
	hover:border-zinc-500 hover:bg-zinc-50
	dark:border-zinc-700 dark:text-zinc-200 dark:hover:border-zinc-500 dark:hover:bg-zinc-800`;
---

<BaseLayout title={SITE_TITLE + ' - ' + t('site.tagline')} description={t('site.description')}>
	<div class='container'>
		<div class='w-full md:flex md:items-center gap-16 mb-10'>
      <div class="text-pretty">
        <h1 class="rise text-4xl sm:text-5xl lg:text-[3.5rem] font-semibold tracking-tight">{AUTHOR_NAME}</h1>
        <p class="rise mt-2 text-lg text-zinc-600 dark:text-zinc-400" style="--rise-i: 1">{AUTHOR_ROLE}</p>
        <div class="rise mt-6 leading-8" style="--rise-i: 2">
          <Prose>
            <div class="text-lg">
              <p>
                {t('home.intro1')}
                <a href={localizePath('/about/', lang)}>{t('home.moreAboutMe')}</a>.
              </p>
            </div>
          </Prose>
        </div>
        <p class="rise mt-4 flex items-start gap-3 text-zinc-700 dark:text-zinc-300" style="--rise-i: 3">
          <span class="availability-dot mt-2.5" aria-hidden="true"></span>
          <span>{t('home.intro2')}</span>
        </p>
        {/* z-10: .rise leaves each block in its own stacking context, so without it
            the photo below would paint over the open contact menu on phones. */}
        <div class="rise relative z-10 mt-7 flex flex-wrap items-center gap-3" style="--rise-i: 4">
          <ContactMenu />
          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class={secondaryButton}>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
            {t('home.ctaGithub')}
          </a>
          {
            hasCv && (
              <a href={CV_PATH} target="_blank" rel="noopener" class={secondaryButton}>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/></svg>
                {t('home.ctaCv')}
              </a>
            )
          }
        </div>
      </div>
      <div class="rise shrink-0 mx-4 mt-10 md:mx-0 md:mt-0" style="--rise-i: 3">
        <Image
          src={Ava}
          alt={AUTHOR_NAME}
          width={300}
          densities={[1, 2]}
          loading="eager"
          class="hero-photo rounded-3xl rotate-2 ring-1 ring-zinc-900/5 dark:ring-white/10 max-w-[calc(100%-3rem)] h-auto"
        />
      </div>
		</div>
		<main>
      <section class='mt-20'>
        <div class="flex items-baseline justify-between gap-4 mb-6">
          <h2 class="text-2xl font-semibold tracking-tight">{t('home.myProjects')}</h2>
          <a href={localizePath('/projects/', lang)} class="arrow-link">
            {t('home.allProjects')}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
        <ProjectList projects={top6Projects} variant="stacked"/>
      </section>
      <section class='mt-20'>
        <div class="flex items-baseline justify-between gap-4 mb-4">
          <h2 class="text-2xl font-semibold tracking-tight">{t('home.recentPosts')}</h2>
          <a href={localizePath('/posts/', lang)} class="arrow-link">
            {t('home.allPosts')}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
        <div class="border-t border-zinc-200 dark:border-zinc-700">
          {
            posts.map((post: BlogPost) => (
              <PostItem post={post} />
            ))
          }
        </div>
      </section>
		</main>
	</div>
</BaseLayout>

<style>
  .availability-dot {
    position: relative;
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background-color: var(--accent);
  }
  .availability-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-color: var(--accent);
    animation: availability-ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes availability-ping {
    75%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  /* The photo straightens when hovered: a small sign the page was made by hand. */
  .hero-photo {
    transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hero-photo:hover {
    transform: rotate(0deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .availability-dot::after {
      animation: none;
      opacity: 0;
    }
    .hero-photo {
      transition: none;
    }
  }
</style>
